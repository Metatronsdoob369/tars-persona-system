      },
      "id": "review-agent",
      "name": "Review Agent",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 550]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \n  \"agent\": $json.body.agent || 'research',\n  \"status\": \"success\",\n  \"output\": $json.stdout,\n  \"error\": $json.stderr\n} }}"
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 400]
    }
  ],
